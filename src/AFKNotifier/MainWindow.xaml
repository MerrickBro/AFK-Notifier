<Window x:Class="AFKNotifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFK Notifier"
        Width="600"
        MinWidth="500"
        MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Foreground="#F2F4F8"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F4F8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C2028"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#383F4C"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="BorderBrush" Value="#383F4C"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#252B36"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#3D4655"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="AFK Notifier" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Monitor one application's audio and alert until AFK is heard."
                           Margin="0,5,0,0" Foreground="#AAB2C0" FontSize="13"/>
            </StackPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Application input" Margin="0,0,0,6" Foreground="#C7CDD7"/>
                    <ComboBox x:Name="ApplicationComboBox" DisplayMemberPath="DisplayName" MinHeight="38"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" VerticalAlignment="Bottom" Click="RefreshButton_Click"/>
            </Grid>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Alert output" Margin="0,0,0,6" Foreground="#C7CDD7"/>
                <ComboBox x:Name="OutputComboBox" DisplayMemberPath="DisplayName" MinHeight="38"/>
            </StackPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Trigger phrase" Margin="0,0,0,6" Foreground="#C7CDD7"/>
                    <TextBox x:Name="TriggerTextBox" Text="AFK"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Beep interval (seconds)" Margin="0,0,0,6" Foreground="#C7CDD7"/>
                    <TextBox x:Name="IntervalTextBox" Text="1.0"/>
                </StackPanel>
            </Grid>

            <Border Background="#181C23" BorderBrush="#303744" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Beep settings" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Idle beep" VerticalAlignment="Center" Foreground="#C7CDD7"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pitch (Hz)" Margin="0,0,0,5" Foreground="#AAB2C0" FontSize="12"/>
                            <TextBox x:Name="IdlePitchTextBox" Text="750"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Volume (%)" Margin="0,0,0,5" Foreground="#AAB2C0" FontSize="12"/>
                            <TextBox x:Name="IdleVolumeTextBox" Text="28"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Confirmation" VerticalAlignment="Center" Foreground="#C7CDD7"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pitch (Hz)" Margin="0,0,0,5" Foreground="#AAB2C0" FontSize="12"/>
                            <TextBox x:Name="ConfirmationPitchTextBox" Text="1000"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Volume (%)" Margin="0,0,0,5" Foreground="#AAB2C0" FontSize="12"/>
                            <TextBox x:Name="ConfirmationVolumeTextBox" Text="28"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#181C23" BorderBrush="#303744" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Audio path" FontWeight="SemiBold"/>
                    <TextBlock Text="Selected application → process loopback → local speech recognition"
                               Margin="0,4,0,0" Foreground="#AAB2C0" TextWrapping="Wrap"/>
                    <TextBlock Text="The microphone is not used."
                               Margin="0,3,0,0" Foreground="#AAB2C0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="StartButton" Content="Start" Width="110" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Stop" Width="110" Margin="10,0,0,0" IsEnabled="False" Click="StopButton_Click"/>
            </StackPanel>

            <Border Background="#181C23" BorderBrush="#303744" BorderThickness="1" CornerRadius="8" Padding="12">
                <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="#B6C0CE" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
