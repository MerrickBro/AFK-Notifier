<Window x:Class="AFKNotifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFK Notifier"
        Width="620"
        Height="520"
        MinWidth="520"
        MinHeight="470"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Foreground="#F2F4F8"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F4F8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C2028"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#383F4C"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1C2028"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="BorderBrush" Value="#383F4C"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#252B36"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#3D4655"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="AFK Notifier" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Monitor one application's audio and alert until AFK is heard."
                       Margin="0,6,0,0" Foreground="#AAB2C0" FontSize="13"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Application input" Margin="0,0,0,6" Foreground="#C7CDD7"/>
                <ComboBox x:Name="ApplicationComboBox" DisplayMemberPath="DisplayName" MinHeight="38"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" VerticalAlignment="Bottom" Click="RefreshButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Alert output" Margin="0,0,0,6" Foreground="#C7CDD7"/>
            <ComboBox x:Name="OutputComboBox" DisplayMemberPath="DisplayName" MinHeight="38"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Trigger phrase" Margin="0,0,0,6" Foreground="#C7CDD7"/>
                <TextBox x:Name="TriggerTextBox" Text="AFK"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Beep interval (seconds)" Margin="0,0,0,6" Foreground="#C7CDD7"/>
                <TextBox x:Name="IntervalTextBox" Text="1.0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Background="#181C23" BorderBrush="#303744" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,2,0,18">
            <StackPanel>
                <TextBlock Text="Audio path" FontWeight="SemiBold"/>
                <TextBlock Text="Selected application → process loopback → local speech recognition"
                           Margin="0,5,0,0" Foreground="#AAB2C0" TextWrapping="Wrap"/>
                <TextBlock Text="The microphone is not used."
                           Margin="0,3,0,0" Foreground="#AAB2C0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,18">
            <Button x:Name="StartButton" Content="Start" Width="110" Click="StartButton_Click"/>
            <Button x:Name="StopButton" Content="Stop" Width="110" Margin="10,0,0,0" IsEnabled="False" Click="StopButton_Click"/>
        </StackPanel>

        <Border Grid.Row="7" Background="#181C23" BorderBrush="#303744" BorderThickness="1" CornerRadius="8" Padding="12">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="#B6C0CE" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
