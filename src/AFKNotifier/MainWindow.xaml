<Window x:Class="AFKNotifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFK Notifier"
        Width="620"
        Height="740"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#B0E0FF"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="16"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#B0E0FF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#B0FFE0"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#080E16"/>
        <SolidColorBrush x:Key="FrameBrush" Color="#17191A"/>
        <SolidColorBrush x:Key="FrameLightBrush" Color="#33383D"/>

        <DataTemplate x:Key="DisplayNameTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"
                       FontFamily="{DynamicResource AppFontFamily}"
                       FontSize="17"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>

        <Style x:Key="TerminalComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{StaticResource DisplayNameTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#B0E0FF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#16242C"/>
                                <Setter Property="Foreground" Value="#B0FFE0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#B0FFE0"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0,0,0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource TerminalComboBoxItemStyle}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectedItem}"
                                                      ContentTemplate="{StaticResource DisplayNameTemplate}"/>

                                    <Border Grid.Column="1"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1,0,0,0">
                                        <TextBlock Text="▼"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="12"/>
                                    </Border>

                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="DropDownPopup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding PlacementTarget.ActualWidth, ElementName=DropDownPopup}"
                                        MaxHeight="280"
                                        Margin="0,2,0,0"
                                        Background="#000000"
                                        BorderBrush="#B0E0FF"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#B0FFE0"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#B0FFE0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SiteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B0E0FF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B0FFE0"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource SiteButtonStyle}"/>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#17191A"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B0E0FF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#83354E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#80B0E0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17191A" BorderBrush="#252525" BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="AFK NOTIFIER"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"/>
                <Button Grid.Column="1" Style="{StaticResource TitleBarButtonStyle}" Content="—" Click="MinimizeButton_Click"/>
                <Button Grid.Column="2" Style="{StaticResource CloseTitleBarButtonStyle}" Content="X" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="7" Background="#17191A" BorderBrush="#252525" BorderThickness="2">
            <Border Margin="5" Background="#000000" BorderBrush="#33383D" BorderThickness="4">
                <Border Background="#080E16" BorderBrush="#161616" BorderThickness="2">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AFK NOTIFIER" FontSize="30" FontWeight="Bold"/>
                                <TextBlock Text="PROCESS AUDIO // WAIT FOR TRIGGER // CONFIRM"
                                           Margin="0,2,0,0"
                                           FontSize="13"
                                           Opacity="0.72"/>
                            </StackPanel>
                            <TextBlock x:Name="VersionTextBlock"
                                       Grid.Column="1"
                                       Text="V1.0.0"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="13"/>
                        </Grid>

                        <Border Grid.Row="1" Height="2" Background="#B0E0FF" Opacity="0.6" Margin="0,0,0,9"/>

                        <Grid Grid.Row="2" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="APPLICATION INPUT" Margin="0,0,0,3" FontSize="14"/>
                                <ComboBox x:Name="ApplicationComboBox" MinHeight="36"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="RefreshButton" Content="REFRESH" VerticalAlignment="Bottom" MinHeight="36" Click="RefreshButton_Click"/>
                        </Grid>

                        <StackPanel Grid.Row="3" Margin="0,0,0,9">
                            <TextBlock Text="ALERT OUTPUT" Margin="0,0,0,3" FontSize="14"/>
                            <ComboBox x:Name="OutputComboBox" MinHeight="36"/>
                        </StackPanel>

                        <Grid Grid.Row="4" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TRIGGER PHRASE" Margin="0,0,0,3" FontSize="14"/>
                                <TextBox x:Name="TriggerTextBox" Text="AFK"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BEEP INTERVAL (SECONDS)" Margin="0,0,0,3" FontSize="14"/>
                                <TextBox x:Name="IntervalTextBox" Text="1.0"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="5" Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock Text="> BEEP SETTINGS" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="0,0,0,7"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IDLE" FontSize="15" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PITCH (HZ)" FontSize="12" Opacity="0.72"/>
                                        <TextBox x:Name="IdlePitchTextBox" Text="750"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="VOLUME (%)" FontSize="12" Opacity="0.72"/>
                                        <TextBox x:Name="IdleVolumeTextBox" Text="28"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="#B0E0FF" Opacity="0.25" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CONFIRM" FontSize="15" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PITCH (HZ)" FontSize="12" Opacity="0.72"/>
                                        <TextBox x:Name="ConfirmationPitchTextBox" Text="1000"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="VOLUME (%)" FontSize="12" Opacity="0.72"/>
                                        <TextBox x:Name="ConfirmationVolumeTextBox" Text="28"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="6" Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,9" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="> AUDIO PATH" Foreground="{StaticResource AccentBrush}" FontSize="15"/>
                                <TextBlock Text="SELECTED APPLICATION -> PROCESS LOOPBACK -> LOCAL SPEECH RECOGNITION"
                                           Margin="0,2,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Opacity="0.78"/>
                                <TextBlock Text="MICROPHONE: NOT USED"
                                           Margin="0,1,0,0"
                                           FontSize="12"
                                           Opacity="0.78"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,9">
                            <Button x:Name="StartButton" Content="START" Width="108" Click="StartButton_Click"/>
                            <Button x:Name="StopButton" Content="STOP" Width="108" Margin="8,0,0,0" IsEnabled="False" Click="StopButton_Click"/>
                        </StackPanel>

                        <Border Grid.Row="9" Style="{StaticResource SectionBorderStyle}" Padding="9,7">
                            <TextBlock x:Name="StatusTextBlock" Text="READY" FontSize="15" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Border>
    </Grid>
</Window>